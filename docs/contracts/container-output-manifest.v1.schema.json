{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oraja-training.dev/contracts/container-output/v1/schema.json",
  "title": "oraja-training Container output manifest v1",
  "description": "Deterministic output summary from one profile-scoped normalization job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "job_id",
    "idempotency_key",
    "account_id",
    "profile_id",
    "trust_domain",
    "eligibility_status",
    "input_manifest_sha256",
    "output_revision",
    "generated_at",
    "normalization",
    "counters",
    "artifacts",
    "raw_db_exported"
  ],
  "properties": {
    "contract": { "const": "container-output-manifest" },
    "schema_version": { "const": "1" },
    "job_id": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/uuidv7" },
    "idempotency_key": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/idempotencyKey" },
    "account_id": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/uuidv7" },
    "profile_id": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/uuidv7" },
    "trust_domain": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/trustDomain" },
    "eligibility_status": { "enum": ["pending", "eligible", "ineligible", "revoked"] },
    "input_manifest_sha256": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/sha256" },
    "output_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "generated_at": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/timestamp" },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "event_contract"],
      "properties": {
        "version": { "const": "normalization-v1" },
        "event_contract": { "const": "play-event.v1" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_events", "rejected_events"],
      "properties": {
        "accepted_events": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/nonNegativeInteger" },
        "rejected_events": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/nonNegativeInteger" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "object_key", "sha256", "size_bytes", "content_type"],
        "properties": {
          "kind": {
            "enum": ["normalized_events", "feature_input", "model_input", "recommend_header", "recommend_score", "daily_menu_header", "daily_menu_score"]
          },
          "object_key": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/objectKey" },
          "sha256": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/sha256" },
          "size_bytes": { "$ref": "https://oraja-training.dev/contracts/common.schema.json#/$defs/nonNegativeInteger" },
          "content_type": { "enum": ["application/json", "application/zstd"] }
        }
      }
    },
    "raw_db_exported": { "const": false }
  }
}
