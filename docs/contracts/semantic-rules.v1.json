{
  "contract": "semantic-rules", "schema_version": "1",
  "scope": { "region": "JP", "language": "ja", "service": "official-cloudflare-only", "game_mode": "SP7", "play_kind": "normal" },
  "ir_ingest": {
    "endpoint": "POST /v1/ir/events", "future_clock_skew_seconds": 300,
    "atomic_accept": ["play_event", "job", "revision", "outbox", "alarm"],
    "responses": { "new": 202, "same_event_same_payload": 200, "same_event_conflict": 409 },
    "headers": ["Location", "Retry-After"], "job_states": ["queued", "running", "succeeded", "failed"],
    "queue_dispatch": "durable-object-alarm", "retry": { "attempts": 5, "strategy": "exponential-backoff-with-jitter", "exhausted": "dlq", "operator_replay_same_job_id": true }
  },
  "problem_details": { "rfc": 9457, "media_type": "application/problem+json", "extensions": ["code", "trace_id", "retryable"] },
  "breaking_change": { "old_client_status": 426, "fields": ["minimum_client_version", "update_url"], "client_stops_retry": true },
  "client_spool": { "max_pending_events": 10000, "max_pending_days": 90, "delete_on_ack": true, "overflow": "stop-new-and-warn", "permanent_rejection": "delete-payload", "rejection_reason_days": 30, "course": "success-without-network-or-spool" },
  "five_db": { "beatoraja_must_be_stopped": true, "files": ["score.db", "scoredatalog.db", "scorelog.db", "songdata.db", "songinfo.db"], "sidecars_forbidden": ["-wal", "-shm"], "max_file_bytes": 2147483648, "max_total_bytes": 5368709120, "history_authority": "live_ir", "dedupe": "strict-fingerprint", "conflict_winner": "live_ir", "conflict_audit": true, "backfill_event_id": "server-generated-uuidv7", "backfill_job_count": 1, "backfill_revision_count": 1, "aggregate_input": false },
  "revision": { "live_event_reserves_revision": true, "publish_bundle": ["player-recommend", "daily-menu"], "latest_update": "candidate>current", "queue_delivery": "duplicate-and-out-of-order-safe" },
  "aggregate": { "input": "quality-gated-live-ir-only", "input_provenance": { "allowed_sources": ["live_ir"], "forbidden_sources": ["five_db", "five_db_backfill"] }, "schedule": "daily", "minimum_profiles": 100, "max_profile_contribution": 0.01, "membership_inference_auc_95_upper": 0.55, "tpr_at_1pct_fpr_max": 0.05, "known_record_exact_extractions_max": 0, "failure": "unpublish-latest-and-retrain-without-deleted-profile", "below_minimum": "personal-model-only" },
  "consent": { "collective_learning_required_for_registration": true, "withdrawal": "stop-collection-and-enter-deletion", "legal_fallback": "optional-opt-in-default-off-and-personal-features-continue", "material_update_gate": { "blocked": ["ir-ingest", "five-db-upload", "mcp-write"], "allowed": ["read", "export", "delete"] } },
  "mcp": { "protocol": "2026-07-28", "transport": "streamable-http", "legacy_initialize_session": false, "oauth": "authorization-code-pkce", "discovery_metadata": true, "client_metadata": ["cimd", "dynamic-client-registration", "pre-registered-major-clients"], "dcr": true },
  "credentials": { "account": { "user_id": { "normalization": "lowercase", "min_length": 3, "max_length": 32, "unique_after_normalization": true }, "password": { "min_length": 12, "max_length": 128, "stored": "argon2id-hash" }, "recovery_codes": { "count": 10, "single_use": true, "stored": "hash" }, "email": { "optional": true, "verification_state_required": true }, "password_reset": { "minutes": 15, "single_use": true, "stored": "hash" } }, "ir": { "bits": 256, "stored": "hash", "expires": "never", "inactive_revoke_days": 90, "individually_revocable": true }, "web": { "cookie": ["Secure", "HttpOnly", "SameSite", "__Host-"], "idle_days": 30, "sensitive_reauth_minutes": 15 }, "mcp": { "access_minutes": 60, "rotating_refresh_days": 30 }, "table_urls": { "separate": ["recommend", "today"], "bits": 256, "stored": "hash", "old_url_after_revoke": 404 } },
  "retention": { "profile_delete_cancellation_days": 7, "backup_max_days": 30, "superseded_artifact_body_days": 90, "failed_job_diagnostic_days": 30, "security_log_days": 30, "audit_log_days": 365, "profile_key_destroyed_on_confirmed_delete": true },
  "artifact_publish": { "required_kinds": ["recommend_table", "daily_menu"], "same_profile": ["manifest", "latest_pointer"], "same_revision": ["manifest", "latest_pointer"], "same_recommendation_version": ["manifest", "latest_pointer"], "previous_revision": "observed-current-and-less-than-revision", "first_previous_revision": 0, "manifest_digest": { "canonicalization": "RFC8785", "excluded_member": "latest_pointer", "algorithm": "sha256" }, "capability_kinds": ["recommend_table", "daily_menu"], "private_kinds": ["web_export", "model_snapshot"] },
  "repositories": { "phase0_mutation": false, "split_and_visibility_execution_issues": [22, 23], "license_and_visibility_decision": "deferred-to-issues-22-and-23" }
