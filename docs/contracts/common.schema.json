{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oraja-training.dev/contracts/common.schema.json",
  "title": "oraja-training shared contract definitions",
  "$defs": {
    "uuidv7": {
      "type": "string",
      "description": "Lower-case RFC 9562 UUID version 7.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "objectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"
    },
    "trustDomain": { "const": "official" },
    "gameMode": {
      "const": "SP7"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "uuidOrNull": {
      "anyOf": [
        { "$ref": "#/$defs/uuidv7" },
        { "type": "null" }
      ]
    }
  }
}
